@@ class Catalog: new helper @@
+    /** Price band for custom_label_3. Input: final EUR price sent to Merchant (2 decimals). Unknown/invalid -> 'p_invalid'. */
+    public static function priceBand($price)
+    {
+        if (!is_numeric($price) || $price <= 0) { return 'p_invalid'; }
+        $p=round((float)$price,2);
+        if ($p<20) { return 'p_lt20'; }
+        if ($p<50) { return 'p_20_49'; }
+        if ($p<200) { return 'p_50_199'; }
+        if ($p<500) { return 'p_200_499'; }
+        if ($p<1500) { return 'p_500_1499'; }
+        if ($p<3000) { return 'p_1500_2999'; }
+        if ($p<5000) { return 'p_3000_4999'; }
+        return 'p_5000_plus';
+    }
